# Public client configuration only. EXPO_PUBLIC_* values are bundled into the
# app and visible to anyone — never put secrets here.

# Leave unset in development: the app uses the Expo dev-server host on :3000,
# which works for the simulator and for a phone on the same Wi-Fi.
# Set explicitly for a physical iPhone if auto-detection fails, e.g.
# EXPO_PUBLIC_SPACETIME_URI=ws://192.168.1.20:3000
EXPO_PUBLIC_SPACETIME_URI=

EXPO_PUBLIC_SPACETIME_DB=orbit-dev
