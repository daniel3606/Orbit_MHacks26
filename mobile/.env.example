# Public client configuration only. EXPO_PUBLIC_* values are bundled into the
# app and visible to anyone — never put secrets here.
#
# The phone connects to SpacetimeDB. It does not call FastAPI. Provider keys
# stay in backend/.env.

# Development: leave unset. The app uses the Expo dev-server host on :3000
# (simulator, or a phone on the same Wi-Fi). Set a LAN address only if
# auto-detection fails, for example ws://192.168.1.20:3000.
#
# TestFlight / production: do not put the URL in this file. Set it in the EAS
# production environment after SpacetimeDB is publicly reachable:
#   npx eas-cli env:set --environment production --name EXPO_PUBLIC_SPACETIME_URI --value wss://<public-host> --visibility plaintext
#   npx eas-cli env:set --environment production --name EXPO_PUBLIC_SPACETIME_DB --value <database> --visibility plaintext
# Production refuses a missing value, localhost, and private network addresses.
EXPO_PUBLIC_SPACETIME_URI=

EXPO_PUBLIC_SPACETIME_DB=orbit-dev
