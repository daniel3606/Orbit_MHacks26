{
  "name": "orbit-spacetime-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "publish:test-db": "spacetime publish orbit-test --server local --module-path ../spacetimedb --delete-data=always --no-config --yes",
    "typecheck": "tsc --noEmit -p .",
    "test": "npm run publish:test-db && node --import tsx --test --test-concurrency=1 --test-reporter=spec integration.test.ts market.test.ts"
  },
  "dependencies": {
    "spacetimedb": "2.10.2"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "tsx": "4.23.15",
    "typescript": "5.6.3"
  }
}
