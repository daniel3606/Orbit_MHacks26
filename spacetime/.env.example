# The SpacetimeDB module has no runtime environment variables. Configuration
# lives in tables (e.g. the service_identity allowlist) and is changed through
# admin-only reducers. These variables are read by the test/dev scripts only.

# Local server used by `spacetime start` (default listens on 0.0.0.0:3000).
STDB_URI=ws://127.0.0.1:3000
# Database used by `npm test` in spacetime/tests (republished with data wiped).
STDB_DB=orbit-test
