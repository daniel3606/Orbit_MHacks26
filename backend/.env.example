# Copy to backend/.env (gitignored). Every value is optional for the current phase
# unless marked REQUIRED. Never commit real values.

APP_ENV=development
LOG_LEVEL=INFO

# --- SpacetimeDB ---
SPACETIME_HTTP_URL=http://127.0.0.1:3000
SPACETIME_DATABASE=orbit-dev
# Worker service token. REQUIRED for the worker and /ready. Prefer the token file
# written by `uv run python -m scripts.bootstrap_service_identity --grant`
# (backend/.secrets/service_token); set this only to override it.
SPACETIME_SERVICE_TOKEN=
SPACETIME_TIMEOUT_SECONDS=10

# --- Worker ---
WORKER_ID=worker-local-1
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_MAX_POLL_INTERVAL_SECONDS=5
WORKER_LEASE_SECONDS=30
WORKER_CONCURRENCY=2

# --- Market data (Finnhub) — used by the worker's ingest_market job ---
# Backend only; never put this in mobile/.env or any EXPO_PUBLIC_* variable.
FINNHUB_API_KEY=
# Stay under the plan limit (x-ratelimit-limit header; 60/min observed on the
# current key) and the documented 30 calls/second cap.
FINNHUB_CALLS_PER_MINUTE=50
FINNHUB_BURST=20
FINNHUB_MAX_RETRIES=3
MARKET_INGEST_ENABLED=true

# --- Providers for later phases ---
JEV_API_KEY=
JEV_BASE_URL=
OPENAI_API_KEY=
# Alpaca PAPER credentials only. Live endpoints are rejected by config validation.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
