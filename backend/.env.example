# Copy to backend/.env (gitignored). Every value is optional for the current phase
# unless marked REQUIRED. Never commit real values.

APP_ENV=development
LOG_LEVEL=INFO

# --- SpacetimeDB ---
# Development may use the local server. APP_ENV=production refuses localhost,
# private IPs, and any URL that is not https, and it requires
# SPACETIME_SERVICE_TOKEN in the environment (the local token file is ignored
# for that check). Set the public URL only after you choose a host.
SPACETIME_HTTP_URL=http://127.0.0.1:3000
SPACETIME_DATABASE=orbit-dev
# Worker service token. REQUIRED for the worker and /ready. Prefer the token file
# written by `uv run python -m scripts.bootstrap_service_identity --grant`
# (backend/.secrets/service_token); set this only to override it.
SPACETIME_SERVICE_TOKEN=
SPACETIME_TIMEOUT_SECONDS=10

# --- Worker ---
WORKER_ID=worker-local-1
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_MAX_POLL_INTERVAL_SECONDS=5
WORKER_LEASE_SECONDS=30
WORKER_CONCURRENCY=2

# --- Market data (Finnhub) — used by the worker's ingest_market job ---
# Backend only; never put this in mobile/.env or any EXPO_PUBLIC_* variable.
FINNHUB_API_KEY=
# Stay under the plan limit (x-ratelimit-limit header; 60/min observed on the
# current key) and the documented 30 calls/second cap.
FINNHUB_CALLS_PER_MINUTE=50
# Part of the budget above kept for news a person is waiting on (Discovery, briefs, chat).
FINNHUB_INTERACTIVE_CALLS_PER_MINUTE=10
FINNHUB_BURST=20
FINNHUB_MAX_RETRIES=3
MARKET_INGEST_ENABLED=true

# --- News classification (Jev, TypeSafe's decision model, served by OpenRouter) ---
# An OpenRouter API key (https://openrouter.ai/settings/keys); billed to that account per input token.
# Backend only. Leave empty to run without classification: news stays unlabeled and the
# classification-dependent fields report "not_configured" instead of a guess.
JEV_API_KEY=
# The only verified contract is OpenRouter's Decisions API; other hosts are rejected.
JEV_BASE_URL=https://openrouter.ai/api
# Pinned release. `~typesafe/jev-latest` floats to new releases and would shift tuned thresholds.
JEV_MODEL=typesafe/jev-1.13
JEV_TIMEOUT_SECONDS=8
# OpenRouter publishes no per-minute cap for paid models; this is Orbit's own ceiling.
JEV_CALLS_PER_MINUTE=120
JEV_BURST=10
# Transient failures only (timeouts, 429, 5xx). 401/402/403 and malformed responses are never retried.
JEV_MAX_RETRIES=2

# --- Explanations (OpenAI) ---
OPENAI_API_KEY=
# Responses API model id. The key stays on the backend.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_OUTPUT_TOKENS=350
# Alpaca PAPER trading credentials. Live trading endpoints are rejected.
# These keys also authenticate market-data requests. Historical bars use a
# separate host and cannot place orders.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Historical daily bars only. Must stay on the market-data host, not paper-api
# or the live trading API. Leave unset to use the default.
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
# Observed account limit is 200 requests/minute. Stay under it.
ALPACA_DATA_CALLS_PER_MINUTE=150
ALPACA_DATA_BURST=10
# 64 hex characters, with or without 0x. The worker refuses paper orders for every other identity.
# Bind once: spacetime call orbit-dev bind_paper_demo --server local '"0x..."'
# Move an existing binding without changing the Alpaca account:
# spacetime call orbit-dev rebind_paper_demo --server local '"0x..."'
PAPER_DEMO_IDENTITY=
